{
  "datasets": [
    {
      "name": "ds_plan",
      "displayName": "Best options",
      "queryLines": [
        "SELECT concat(opponent_name, ', ', date_format(series_start, 'MMM d, yyyy')) AS series, batter_name AS batter, concat(pitcher_name, if(is_probable_starter, ' (probable starter)', '')) AS pitcher, scenario_order, scenario_label AS situation, option_rank, initcap(tier) AS tier, pitch_name AS pitch, location, round(-100 * vs_usual, 1) AS better_than_usual, concat(format_number(-100 * (expected_run_value_high - usual_expected_run_value), 1), ' to ', format_number(-100 * (expected_run_value_low - usual_expected_run_value), 1)) AS better_range, usual_share AS his_share FROM pitch_option_scores WHERE option_rank <= 3 ORDER BY series, batter, pitcher, scenario_order, option_rank "
      ]
    },
    {
      "name": "ds_usual",
      "displayName": "Usual choices",
      "queryLines": [
        "SELECT concat(opponent_name, ', ', date_format(series_start, 'MMM d, yyyy')) AS series, batter_name AS batter, concat(pitcher_name, if(is_probable_starter, ' (probable starter)', '')) AS pitcher, scenario_order, scenario_label AS situation, initcap(tier) AS tier, pitch_name AS pitch, location, round(-100 * vs_usual, 1) AS better_than_usual, usual_share AS his_share FROM pitch_option_scores WHERE usual_share > 0 QUALIFY row_number() OVER (PARTITION BY series_start, opponent_id, pitcher_id, batter_id, scenario ORDER BY usual_share DESC) <= 3 ORDER BY series, batter, pitcher, scenario_order, his_share DESC "
      ]
    },
    {
      "name": "ds_zones",
      "displayName": "Options by location",
      "queryLines": [
        "SELECT concat(opponent_name, ', ', date_format(series_start, 'MMM d, yyyy')) AS series, batter_name AS batter, concat(pitcher_name, if(is_probable_starter, ' (probable starter)', '')) AS pitcher, scenario_order, scenario_label AS situation, grid_x, grid_y, pitch_name AS pitch, round(-100 * vs_usual, 1) AS better_than_usual, tier FROM pitch_option_scores "
      ]
    },
    {
      "name": "ds_staff",
      "displayName": "Staff matchups",
      "queryLines": [
        "WITH s AS (SELECT DISTINCT series_start, opponent_id, opponent_name, batter_id, batter_name, pitcher_id, pitcher_name, is_probable_starter, scenario, scenario_order, scenario_label, usual_expected_run_value FROM pitch_option_scores) SELECT concat(opponent_name, ', ', date_format(series_start, 'MMM d, yyyy')) AS series, batter_name AS batter, concat(pitcher_name, if(is_probable_starter, ' (probable starter)', '')) AS pitcher, concat(lpad(scenario_order, 2, '0'), ' ', upper(substr(regexp_replace(regexp_replace(scenario_label, ', bases empty(, one out)?$', ''), '^Pitcher ', ''), 1, 1)), substr(regexp_replace(regexp_replace(scenario_label, ', bases empty(, one out)?$', ''), '^Pitcher ', ''), 2)) AS situation, round(100 * (avg(usual_expected_run_value) OVER (PARTITION BY series_start, opponent_id, batter_id, scenario) - usual_expected_run_value), 2) AS vs_staff FROM s "
      ]
    },
    {
      "name": "ds_rank",
      "displayName": "Matchup rankings by pitcher",
      "queryLines": [
        "WITH m AS (SELECT series_start, opponent_id, opponent_name, pitcher_id, pitcher_name, is_probable_starter, batter_id, batter_name, lineup_spot, max(CASE WHEN policy = 'usual' THEN run_value END) AS usual_rv, max(CASE WHEN policy = 'recommended' THEN run_value END) AS recommended_rv, max(CASE WHEN policy = 'usual' THEN p_strikeout END) AS k_rate, max(CASE WHEN policy = 'usual' THEN p_walk END) AS bb_rate, max(CASE WHEN policy = 'usual' THEN p_home_run END) AS hr_rate, max(CASE WHEN policy = 'usual' THEN pitches END) AS pitches FROM matchup_simulations GROUP BY ALL) SELECT concat(opponent_name, ', ', date_format(series_start, 'MMM d, yyyy')) AS series, concat(pitcher_name, if(is_probable_starter, ' (probable starter)', '')) AS pitcher, round(-100 * avg(usual_rv), 2) AS runs_saved, avg(k_rate) AS k_rate, avg(bb_rate) AS bb_rate, avg(hr_rate) AS hr_rate, round(avg(pitches), 2) AS pitches_per_pa, round(100 * avg(usual_rv - recommended_rv), 2) AS gain_recommended FROM m GROUP BY series_start, opponent_id, opponent_name, pitcher_id, pitcher_name, is_probable_starter "
      ]
    },
    {
      "name": "ds_matchups",
      "displayName": "Matchups by pitcher and hitter",
      "queryLines": [
        "WITH m AS (SELECT series_start, opponent_id, opponent_name, pitcher_id, pitcher_name, is_probable_starter, batter_id, batter_name, lineup_spot, max(CASE WHEN policy = 'usual' THEN run_value END) AS usual_rv, max(CASE WHEN policy = 'recommended' THEN run_value END) AS recommended_rv, max(CASE WHEN policy = 'usual' THEN p_strikeout END) AS k_rate, max(CASE WHEN policy = 'usual' THEN p_walk END) AS bb_rate, max(CASE WHEN policy = 'usual' THEN p_home_run END) AS hr_rate, max(CASE WHEN policy = 'usual' THEN pitches END) AS pitches FROM matchup_simulations GROUP BY ALL) SELECT concat(opponent_name, ', ', date_format(series_start, 'MMM d, yyyy')) AS series, concat(pitcher_name, if(is_probable_starter, ' (probable starter)', '')) AS pitcher, concat(lpad(lineup_spot, 2, '0'), ' ', batter_name) AS batter, round(-100 * usual_rv, 1) AS runs_saved, k_rate, bb_rate FROM m "
      ]
    }
  ],
